import React, { useState } from 'react';
import { MediaAsset } from '../types';
import { motion } from 'motion/react';

interface EditTagsModalProps {
  asset: MediaAsset | null;
  isOpen: boolean;
  onClose: () => void;
  onSave: (updatedAsset: MediaAsset) => void;
}

export const EditTagsModal: React.FC<EditTagsModalProps> = ({
  asset,
  isOpen,
  onClose,
  onSave
}) => {
  if (!isOpen || !asset) return null;

  const [t1Tags, setT1Tags] = useState(asset.tier1Tags.map((t) => t.label).join(', '));
  const [t2Tags, setT2Tags] = useState(asset.tier2Tags.map((t) => t.label).join(', '));
  const [bucket, setBucket] = useState(asset.autoOrganizedBucket);
  const [category, setCategory] = useState(asset.primaryCategory);
  const [confidence, setConfidence] = useState(asset.aiConfidenceScore);

  const handleSave = () => {
    const updatedTier1 = t1Tags.split(',').map((s) => ({ label: s.trim().toUpperCase(), confidence: 0.95 })).filter(t => t.label);
    const updatedTier2 = t2Tags.split(',').map((s) => ({ label: s.trim().toUpperCase(), confidence: 0.90 })).filter(t => t.label);

    const updated: MediaAsset = {
      ...asset,
      primaryCategory: category,
      autoOrganizedBucket: bucket,
      aiConfidenceScore: confidence,
      tier1Tags: updatedTier1,
      tier2Tags: updatedTier2
    };

    onSave(updated);
    onClose();
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
      <motion.div
        initial={{ opacity: 0, scale: 0.95 }}
        animate={{ opacity: 1, scale: 1 }}
        exit={{ opacity: 0, scale: 0.95 }}
        className="bg-[#171f33] border border-white/15 rounded-3xl w-full max-w-md p-6 shadow-2xl space-y-5"
      >
        <div className="flex items-center justify-between pb-3 border-b border-white/10">
          <div>
            <h3 className="font-['Geist'] text-lg font-bold text-white">Edit AI Taxonomy</h3>
            <p className="text-xs text-[#908fa0] font-data-mono truncate max-w-[280px]">
              {asset.fileName}
            </p>
          </div>
          <button
            onClick={onClose}
            className="text-[#908fa0] hover:text-white p-1 rounded-lg"
          >
            <span className="material-symbols-outlined text-lg">close</span>
          </button>
        </div>

        <div className="space-y-4 text-xs font-data-mono">
          <div>
            <label className="text-[#908fa0] uppercase tracking-wider block mb-1.5 font-label-caps">
              Primary Category
            </label>
            <select
              value={category}
              onChange={(e) => setCategory(e.target.value as any)}
              className="w-full bg-[#0b1326] border border-white/10 rounded-xl px-3 py-2.5 text-[#dbe2fd] focus:outline-none"
            >
              <option value="human">Human (Portrait, Group, Candid)</option>
              <option value="nonhuman">Non-Human (Gear, Detail, Decor, Landscape, Venue)</option>
            </select>
          </div>

          <div>
            <label className="text-[#908fa0] uppercase tracking-wider block mb-1.5 font-label-caps">
              Smart Bucket Route
            </label>
            <input
              type="text"
              value={bucket}
              onChange={(e) => setBucket(e.target.value)}
              className="w-full bg-[#0b1326] border border-white/10 rounded-xl px-3 py-2.5 text-[#dbe2fd] focus:outline-none"
              placeholder="/Humans/Couples"
            />
          </div>

          <div>
            <label className="text-[#908fa0] uppercase tracking-wider block mb-1.5 font-label-caps">
              Tier 1 Taxonomy Tags (Comma-separated)
            </label>
            <input
              type="text"
              value={t1Tags}
              onChange={(e) => setT1Tags(e.target.value)}
              className="w-full bg-[#0b1326] border border-white/10 rounded-xl px-3 py-2.5 text-[#dbe2fd] focus:outline-none"
            />
          </div>

          <div>
            <label className="text-[#908fa0] uppercase tracking-wider block mb-1.5 font-label-caps">
              Tier 2 Semantic Tags (Comma-separated)
            </label>
            <input
              type="text"
              value={t2Tags}
              onChange={(e) => setT2Tags(e.target.value)}
              className="w-full bg-[#0b1326] border border-white/10 rounded-xl px-3 py-2.5 text-[#dbe2fd] focus:outline-none"
            />
          </div>

          <div>
            <div className="flex justify-between text-xs mb-1.5">
              <span className="text-[#908fa0] font-label-caps uppercase">AI Confidence</span>
              <span className="text-[#10b981] font-bold">{Math.round(confidence * 100)}%</span>
            </div>
            <input
              type="range"
              min="0.5"
              max="1.0"
              step="0.01"
              value={confidence}
              onChange={(e) => setConfidence(parseFloat(e.target.value))}
              className="w-full accent-[#6366f1] bg-[#0b1326] h-1.5 rounded-lg appearance-none cursor-pointer"
            />
          </div>
        </div>

        <div className="flex items-center gap-3 pt-3 border-t border-white/10">
          <button
            onClick={onClose}
            className="flex-1 py-2.5 bg-[#0b1326] border border-white/10 hover:bg-[#222a3e] rounded-xl text-xs font-data-mono text-[#dbe2fd] transition-colors"
          >
            Cancel
          </button>
          <button
            onClick={handleSave}
            className="flex-1 py-2.5 bg-[#6366f1] hover:bg-[#5254db] text-white rounded-xl text-xs font-data-mono font-bold transition-all shadow-[0_0_15px_rgba(99,102,241,0.3)]"
          >
            Save Changes
          </button>
        </div>
      </motion.div>
    </div>
  );
};
