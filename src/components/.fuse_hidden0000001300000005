import React, { useState } from 'react';
import { MediaAsset, PipelineSettingsState } from '../types';
import { motion } from 'motion/react';

interface IngestionViewProps {
  assets: MediaAsset[];
  pipelineSettings: PipelineSettingsState;
  onUpdateSettings: (settings: PipelineSettingsState) => void;
  onApproveAsset: (assetId: string) => void;
  onEditTags: (asset: MediaAsset) => void;
  onOpenUpload: () => void;
}

export const IngestionView: React.FC<IngestionViewProps> = ({
  assets,
  pipelineSettings,
  onUpdateSettings,
  onApproveAsset,
  onEditTags,
  onOpenUpload
}) => {
  const [activeTab, setActiveTab] = useState<'review' | 'routed'>('review');
  const [isPaused, setIsPaused] = useState(false);
  const [settings, setSettings] = useState<PipelineSettingsState>(pipelineSettings);
  const [showSettingsDrawer, setShowSettingsDrawer] = useState(false);
  const [toastMessage, setToastMessage] = useState<string | null>(null);

  const reviewAssets = assets.filter((a) => a.routeStatus === 'review_needed');
  const routedAssets = assets.filter((a) => a.routeStatus === 'auto_routed');

  const displayList = activeTab === 'review' ? reviewAssets : routedAssets;

  const handleApplySettings = () => {
    onUpdateSettings(settings);
    setToastMessage('Pipeline threshold settings applied successfully');
    setTimeout(() => setToastMessage(null), 2500);
    setShowSettingsDrawer(false);
  };

  const handleApprove = (id: string, fileName: string) => {
    onApproveAsset(id);
    setToastMessage(`Approved route for ${fileName}`);
    setTimeout(() => setToastMessage(null), 2000);
  };

  return (
    <div className="space-y-6 pb-20">
      {/* Toast Notification */}
      {toastMessage && (
        <motion.div
          initial={{ opacity: 0, y: -20 }}
          animate={{ opacity: 1, y: 0 }}
          exit={{ opacity: 0, y: -20 }}
          className="fixed top-24 right-8 z-50 bg-[#171f33] border border-[#10b981]/50 text-[#dbe2fd] px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3 font-['Geist']"
        >
          <span className="material-symbols-outlined text-[#10b981]">check_circle</span>
          <span className="text-sm font-medium">{toastMessage}</span>
        </motion.div>
      )}

      {/* Ingestion Header */}
      <section className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div className="flex flex-wrap items-center gap-2.5 sm:gap-3">
            <h1 className="font-['Geist'] text-2xl sm:text-3xl font-bold tracking-tight text-[#dbe2fd]">
              Ingestion Pipeline
            </h1>
            <span className="bg-[#10b981]/20 text-[#10b981] border border-[#10b981]/30 text-[11px] font-label-caps px-2.5 py-0.5 rounded-full uppercase tracking-wider flex items-center gap-1.5">
              <span className={`w-1.5 h-1.5 rounded-full bg-[#10b981] ${isPaused ? '' : 'animate-ping'}`}></span>
              {isPaused ? 'Paused' : 'Active'}
            </span>
          </div>
          <p className="text-[#94a3b8] text-xs mt-1 font-data-mono">
            Autonomous multi-tier taxonomy &amp; semantic routing stream
          </p>
        </div>

        {/* Action Controls */}
        <div className="flex flex-wrap items-center gap-2 sm:gap-3">
          <button
            onClick={() => setIsPaused(!isPaused)}
            className="px-3 sm:px-4 py-1.5 sm:py-2 bg-[#171f33] border border-white/10 hover:bg-[#222a3e] rounded-xl text-xs font-data-mono text-[#dbe2fd] flex items-center gap-1.5 transition-colors"
          >
            <span className="material-symbols-outlined text-sm sm:text-base text-[#6366f1]">
              {isPaused ? 'play_arrow' : 'pause'}
            </span>
            <span>{isPaused ? 'Resume' : 'Pause'}</span>
          </button>

          <button
            onClick={onOpenUpload}
            className="px-3 sm:px-4 py-1.5 sm:py-2 bg-[#6366f1] hover:bg-[#5254db] text-white rounded-xl text-xs font-data-mono font-bold flex items-center gap-1.5 transition-all shadow-[0_0_15px_rgba(99,102,241,0.3)]"
          >
            <span className="material-symbols-outlined text-sm sm:text-base">add_photo_alternate</span>
            <span>Ingest Files</span>
          </button>

          <button
            onClick={() => setShowSettingsDrawer(!showSettingsDrawer)}
            className="lg:hidden p-1.5 sm:p-2 bg-[#171f33] border border-white/10 rounded-xl text-[#dbe2fd]"
            title="Toggle Settings"
          >
            <span className="material-symbols-outlined text-base sm:text-lg">tune</span>
          </button>
        </div>
      </section>

      {/* Progress Metric Banner */}
      <section className="bg-[#171f33] rounded-2xl p-4 sm:p-6 border border-white/10 shadow-lg space-y-3 sm:space-y-4">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <span className="text-[10px] sm:text-xs font-label-caps text-[#6366f1] uppercase tracking-wider">
              Active Batch 04 · Sarah &amp; John Wedding
            </span>
            <div className="font-['Geist'] text-base sm:text-lg font-bold text-white mt-0.5">
              245 / 245 Assets Analyzed
            </div>
          </div>
          <div className="text-xs font-data-mono text-[#908fa0] text-left sm:text-right">
            <span>00:04:12 Elapsed</span>
            <span className="mx-2">•</span>
            <span className="text-[#10b981]">100% Processed</span>
          </div>
        </div>

        <div className="w-full bg-[#0b1326] h-2.5 rounded-full overflow-hidden p-0.5">
          <div
            className="bg-gradient-to-r from-[#6366f1] via-[#22d3ee] to-[#10b981] h-full rounded-full transition-all duration-500"
            style={{ width: '100%' }}
          ></div>
        </div>
      </section>

      {/* Main Layout: Stream Feed + Pipeline Settings Sidebar */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
        {/* Stream List */}
        <div className="lg:col-span-2 space-y-4">
          {/* Stream Filter Tabs */}
          <div className="flex items-center gap-2 border-b border-white/10 pb-3 overflow-x-auto">
            <button
              onClick={() => setActiveTab('review')}
              className={`px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl text-xs font-data-mono transition-all flex items-center gap-1.5 whitespace-nowrap ${
                activeTab === 'review'
                  ? 'bg-[#6366f1] text-white font-bold shadow-md'
                  : 'text-[#94a3b8] hover:text-[#dbe2fd]'
              }`}
            >
              <span className="material-symbols-outlined text-sm">assignment_late</span>
              Review Needed ({reviewAssets.length})
            </button>
            <button
              onClick={() => setActiveTab('routed')}
              className={`px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl text-xs font-data-mono transition-all flex items-center gap-1.5 whitespace-nowrap ${
                activeTab === 'routed'
                  ? 'bg-[#6366f1] text-white font-bold shadow-md'
                  : 'text-[#94a3b8] hover:text-[#dbe2fd]'
              }`}
            >
              <span className="material-symbols-outlined text-sm">verified</span>
              Auto-Routed ({routedAssets.length})
            </button>
          </div>

          {/* Cards List */}
          <div className="space-y-4">
            {displayList.map((asset) => (
              <div
                key={asset.id}
                className="bg-[#171f33] rounded-2xl p-4 sm:p-5 border border-white/10 hover:border-white/20 transition-all flex flex-col sm:flex-row gap-4 sm:gap-5 shadow-lg group"
              >
                {/* Thumbnail */}
                <div className="relative w-full sm:w-36 h-44 sm:h-36 rounded-xl overflow-hidden bg-[#0b1326] shrink-0">
                  <img
                    alt={asset.fileName}
                    className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    src={asset.thumbnailUrl}
                  />
                  <div className="absolute top-2 left-2 bg-black/70 backdrop-blur-md px-2 py-0.5 rounded text-[9px] font-label-caps text-[#c0c1ff]">
                    {asset.fileName.split('.').pop()?.toUpperCase() || 'RAW'}
                  </div>
                  <div className="absolute bottom-2 right-2 bg-black/70 backdrop-blur-md px-2 py-0.5 rounded text-[9px] font-data-mono text-[#10b981]">
                    {Math.round(asset.aiConfidenceScore * 100)}%
                  </div>
                </div>

                {/* Details & Tags */}
                <div className="flex-1 flex flex-col justify-between space-y-3 min-w-0">
                  <div>
                    <div className="flex items-center justify-between gap-2">
                      <h3 className="font-['Geist'] text-sm sm:text-base font-bold text-white truncate">
                        {asset.fileName}
                      </h3>
                      <span className="text-[10px] sm:text-[11px] font-data-mono text-[#908fa0] shrink-0">
                        {asset.importedAt}
                      </span>
                    </div>

                    {/* Taxonomy Tier 1 */}
                    <div className="mt-2 space-y-1.5">
                      <div className="flex items-center gap-1.5 flex-wrap">
                        <span className="text-[10px] font-label-caps text-[#908fa0] uppercase shrink-0">
                          Tier 1:
                        </span>
                        {asset.tier1Tags.map((t, idx) => (
                          <span
                            key={idx}
                            className="bg-[#6366f1]/20 text-[#c0c1ff] border border-[#6366f1]/30 text-[10px] font-data-mono px-2 py-0.5 rounded-md truncate max-w-[120px]"
                          >
                            {t.label} ({t.confidence.toFixed(2)})
                          </span>
                        ))}
                      </div>

                      {/* Semantics Tier 2 */}
                      <div className="flex items-center gap-1.5 flex-wrap">
                        <span className="text-[10px] font-label-caps text-[#908fa0] uppercase shrink-0">
                          Tier 2:
                        </span>
                        {asset.tier2Tags.map((t, idx) => (
                          <span
                            key={idx}
                            className="bg-[#22d3ee]/20 text-[#22d3ee] border border-[#22d3ee]/30 text-[10px] font-data-mono px-2 py-0.5 rounded-md truncate max-w-[120px]"
                          >
                            {t.label} ({t.confidence.toFixed(2)})
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>

                  {/* Proposed Route & Actions */}
                  <div className="pt-3 border-t border-white/5 flex flex-wrap items-center justify-between gap-2.5">
                    <div className="flex items-center gap-1.5 text-xs font-data-mono min-w-0">
                      <span className="text-[#908fa0] shrink-0">Route:</span>
                      <span className="text-[#10b981] font-semibold bg-[#10b981]/10 px-2 py-0.5 rounded border border-[#10b981]/20 truncate">
                        {asset.autoOrganizedBucket}
                      </span>
                    </div>

                    <div className="flex items-center gap-2">
                      <button
                        onClick={() => onEditTags(asset)}
                        className="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-[#0b1326] border border-white/10 hover:bg-[#222a3e] text-xs font-data-mono text-[#dbe2fd] rounded-lg transition-colors"
                      >
                        Edit Tags
                      </button>

                      {asset.routeStatus === 'review_needed' ? (
                        <button
                          onClick={() => handleApprove(asset.id, asset.fileName)}
                          className="px-3 sm:px-4 py-1 sm:py-1.5 bg-[#10b981] hover:bg-[#0da270] text-slate-950 text-xs font-data-mono font-bold rounded-lg transition-all shadow-[0_0_12px_rgba(16,185,129,0.3)] flex items-center gap-1"
                        >
                          <span className="material-symbols-outlined text-sm">check</span>
                          Approve
                        </button>
                      ) : (
                        <span className="text-xs font-data-mono text-[#10b981] flex items-center gap-1">
                          <span className="material-symbols-outlined text-sm">verified</span>
                          Routed
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            ))}

            {displayList.length === 0 && (
              <div className="p-12 text-center bg-[#171f33] rounded-2xl border border-white/10">
                <span className="material-symbols-outlined text-4xl text-[#908fa0] mb-2">task_alt</span>
                <h4 className="font-['Geist'] text-base font-semibold text-white">All Caught Up!</h4>
                <p className="text-xs text-[#908fa0] mt-1 font-data-mono">
                  No assets currently awaiting manual review.
                </p>
              </div>
            )}
          </div>
        </div>

        {/* Pipeline Settings Right Sidebar (Sticky on Desktop) */}
        <aside
          className={`lg:col-span-1 bg-[#171f33] rounded-2xl border border-white/10 p-6 space-y-6 shadow-2xl sticky top-24 ${
            showSettingsDrawer ? 'block' : 'hidden lg:block'
          }`}
        >
          <div className="flex items-center justify-between pb-3 border-b border-white/10">
            <div>
              <h3 className="font-['Geist'] text-base font-bold text-white">Pipeline Settings</h3>
              <p className="text-[11px] text-[#908fa0] font-data-mono">Confidence &amp; Routing Rules</p>
            </div>
            <span className="material-symbols-outlined text-[#6366f1]">tune</span>
          </div>

          {/* Sliders */}
          <div className="space-y-4">
            <div>
              <div className="flex justify-between text-xs font-data-mono mb-2">
                <span className="text-[#dbe2fd]">Auto-Route Tier 1 Threshold</span>
                <span className="text-[#6366f1] font-bold">
                  {Math.round(settings.tier1Threshold * 100)}%
                </span>
              </div>
              <input
                type="range"
                min="0.5"
                max="0.99"
                step="0.01"
                value={settings.tier1Threshold}
                onChange={(e) => setSettings({ ...settings, tier1Threshold: parseFloat(e.target.value) })}
                className="w-full accent-[#6366f1] bg-[#0b1326] h-1.5 rounded-lg appearance-none cursor-pointer"
              />
            </div>

            <div>
              <div className="flex justify-between text-xs font-data-mono mb-2">
                <span className="text-[#dbe2fd]">Tag Addition Tier 2 Threshold</span>
                <span className="text-[#22d3ee] font-bold">
                  {Math.round(settings.tier2Threshold * 100)}%
                </span>
              </div>
              <input
                type="range"
                min="0.5"
                max="0.99"
                step="0.01"
                value={settings.tier2Threshold}
                onChange={(e) => setSettings({ ...settings, tier2Threshold: parseFloat(e.target.value) })}
                className="w-full accent-[#22d3ee] bg-[#0b1326] h-1.5 rounded-lg appearance-none cursor-pointer"
              />
            </div>
          </div>

          {/* Manual Overrides */}
          <div className="space-y-3 pt-3 border-t border-white/5">
            <span className="text-[10px] font-label-caps text-[#908fa0] uppercase tracking-wider block">
              Manual Overrides
            </span>

            <label className="flex items-center justify-between text-xs font-data-mono text-[#dbe2fd] cursor-pointer">
              <span>Require review for 'People'</span>
              <input
                type="checkbox"
                checked={settings.requireHumanReviewForPeople}
                onChange={(e) => setSettings({ ...settings, requireHumanReviewForPeople: e.target.checked })}
                className="w-4 h-4 rounded accent-[#6366f1] bg-[#0b1326]"
              />
            </label>

            <label className="flex items-center justify-between text-xs font-data-mono text-[#dbe2fd] cursor-pointer">
              <span>Strict mood matching</span>
              <input
                type="checkbox"
                checked={settings.strictMoodMatching}
                onChange={(e) => setSettings({ ...settings, strictMoodMatching: e.target.checked })}
                className="w-4 h-4 rounded accent-[#6366f1] bg-[#0b1326]"
              />
            </label>

            <label className="flex items-center justify-between text-xs font-data-mono text-[#dbe2fd] cursor-pointer">
              <span>Facial Recognition Engine</span>
              <input
                type="checkbox"
                checked={settings.facialRecognitionEnabled}
                onChange={(e) => setSettings({ ...settings, facialRecognitionEnabled: e.target.checked })}
                className="w-4 h-4 rounded accent-[#6366f1] bg-[#0b1326]"
              />
            </label>
          </div>

          {/* Active Model Stack */}
          <div className="p-3 bg-[#0b1326]/60 rounded-xl border border-white/5 space-y-1.5 text-[11px] font-data-mono text-[#94a3b8]">
            <div className="text-[10px] font-label-caps text-[#908fa0] uppercase mb-1">Active Model Stack</div>
            <div className="flex justify-between">
              <span>Vision Core:</span>
              <span className="text-[#10b981]">v2.4 (TensorRT)</span>
            </div>
            <div className="flex justify-between">
              <span>Semantic Parser:</span>
              <span className="text-[#10b981]">v1.1 Active</span>
            </div>
            <div className="flex justify-between">
              <span>EXIF Extraction:</span>
              <span className="text-[#10b981]">Native NativeRAW</span>
            </div>
          </div>

          <button
            onClick={handleApplySettings}
            className="w-full py-2.5 bg-[#6366f1] hover:bg-[#5254db] text-white rounded-xl text-xs font-data-mono font-bold transition-all shadow-[0_0_15px_rgba(99,102,241,0.3)]"
          >
            Apply Changes
          </button>
        </aside>
      </div>
    </div>
  );
};
