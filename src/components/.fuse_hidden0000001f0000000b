                    </span>
                    <span className="text-[#dbe2fd]">{goodLightingCount}</span>
                  </div>
                  <div className="w-full bg-[#171f33] h-1.5 rounded-full overflow-hidden">
                    <div
                      className="bg-[#10b981] h-full rounded-full transition-all"
                      style={{ width: `${videoCount > 0 ? (goodLightingCount / videoCount) * 100 : 0}%` }}
                    ></div>
                  </div>
                </div>

                <div>
                  <div className="flex justify-between text-[11px] font-data-mono mb-1">
                    <span className="text-[#f59e0b] flex items-center gap-1.5">
                      <span className="material-symbols-outlined text-[13px]">brightness_low</span>
                      Bad Lighting
                    </span>
                    <span className="text-[#dbe2fd]">{badLightingCount}</span>
                  </div>
                  <div className="w-full bg-[#171f33] h-1.5 rounded-full overflow-hidden">
                    <div
                      className="bg-[#f59e0b] h-full rounded-full transition-all"
                      style={{ width: `${videoCount > 0 ? (badLightingCount / videoCount) * 100 : 0}%` }}
                    ></div>
                  </div>
                </div>
              </div>
            </div>

            <div className="mt-3 flex items-center justify-between text-[10px] sm:text-[11px] font-data-mono text-[#94a3b8] pt-2.5 border-t border-white/5">
              <span>Exposure</span>
              <span>Contrast</span>
              <span>Clipping</span>
            </div>
          </div>
        </div>
      </section>

      {/* Live Ingestion Feed & System Status */}
      <section className="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
        {/* Live Ingestion Feed */}
        <div className="lg:col-span-2 bg-[#171f33] rounded-2xl p-5 sm:p-6 border border-white/10 shadow-lg">
          <div className="flex items-center justify-between mb-4">
            <div className="flex items-center gap-2">
              <span className="relative flex h-2.5 w-2.5">
                <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10b981] opacity-75"></span>
                <span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#10b981]"></span>
              </span>
              <h3 className="font-['Geist'] text-sm sm:text-base font-bold text-white">Live Ingestion Activity</h3>
            </div>
            <button
              onClick={() => onNavigateTab('ingestion')}
              className="text-xs font-data-mono text-[#6366f1] hover:underline"
            >
              Open Stream →
            </button>
          </div>

          <div className="space-y-2.5">
            {liveEvents.slice(0, 4).map((ev) => (
              <div
                key={ev.id}
                className="bg-[#0b1326]/60 p-3 rounded-xl border border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-3 text-xs font-data-mono hover:bg-[#0b1326] transition-colors"
              >
                <div className="flex items-center gap-2.5 min-w-0">
                  <span className="text-[#908fa0] text-[10px] sm:text-[11px] shrink-0">{ev.timestamp}</span>
                  <div className="flex items-center gap-1.5 min-w-0">
                    {ev.type === 'subject' && <span className="w-1.5 h-1.5 rounded-full bg-[#6366f1] shrink-0"></span>}
                    {ev.type === 'object' && <span className="w-1.5 h-1.5 rounded-full bg-[#22d3ee] shrink-0"></span>}
                    {ev.type === 'warning' && <span className="w-1.5 h-1.5 rounded-full bg-[#f59e0b] shrink-0"></span>}
                    {ev.type === 'batch' && <span className="w-1.5 h-1.5 rounded-full bg-[#10b981] shrink-0"></span>}
                    <span className="text-[#dbe2fd] font-medium truncate">{ev.message}</span>
                  </div>
                </div>
                <div className="text-left sm:text-right shrink-0">
                  <span className="text-[#94a3b8] text-[11px]">{ev.target}</span>
                  {ev.subtext && <span className="text-[#908fa0] text-[10px] ml-1.5">({ev.subtext})</span>}
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* System Status Metrics */}
        <div className="bg-[#171f33] rounded-2xl p-5 sm:p-6 border border-white/10 shadow-lg flex flex-col justify-between">
          <div>
            <h3 className="font-['Geist'] text-sm sm:text-base font-bold text-white mb-4">System Telemetry</h3>
            <div className="space-y-4">
              <div>
                <div className="flex justify-between text-xs font-data-mono mb-1.5">
                  <span className="text-[#908fa0]">Storage Volume</span>
                  <span className="text-[#dbe2fd]">3.12 TB / 4.00 TB (78%)</span>
                </div>
                <div className="w-full bg-[#0b1326] h-1.5 rounded-full overflow-hidden">
                  <div className="bg-[#6366f1] h-full rounded-full" style={{ width: '78%' }}></div>
                </div>
              </div>

              <div>
                <div className="flex justify-between text-xs font-data-mono mb-1.5">
                  <span className="text-[#908fa0]">AI Compute Node</span>
                  <span className="text-[#10b981]">Healthy (45 FPS)</span>
                </div>
                <div className="w-full bg-[#0b1326] h-1.5 rounded-full overflow-hidden">
                  <div className="bg-[#10b981] h-full rounded-full" style={{ width: '92%' }}></div>
                </div>
              </div>

              <div>
                <div className="flex justify-between text-xs font-data-mono mb-1.5">
                  <span className="text-[#908fa0]">Lightroom Bridge</span>
                  <span className="text-[#22d3ee]">Active &amp; Connected</span>
                </div>
                <div className="w-full bg-[#0b1326] h-1.5 rounded-full overflow-hidden">
                  <div className="bg-[#22d3ee] h-full rounded-full" style={{ width: '100%' }}></div>
                </div>
              </div>
            </div>
          </div>

          <div className="pt-4 border-t border-white/5 flex items-center justify-between text-[10px] font-data-mono text-[#908fa0] mt-4">
            <span>LensFlow Core v2.4</span>
            <span>Vision Engine: ON</span>
          </div>
        </div>
      </section>
    </div>
  );
};
