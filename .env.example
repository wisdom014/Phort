# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit it. Only this template belongs in git.
#
# Note: only variables prefixed with VITE_ are exposed to the browser bundle.
# The Supabase anon key below is a PUBLIC (publishable) key — it is designed to
# ship in client code. It is only safe because Row Level Security is enabled on
# every table; see SETUP.md ("Security & Row Level Security") before deploying.

# Supabase project (Settings > API in the Supabase dashboard)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# No AI API key needed — face/mood detection (human.js) and object detection
# (ONNX YOLO) both run fully client-side in the browser. See SETUP.md.
